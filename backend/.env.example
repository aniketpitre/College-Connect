# Required for answer generation (https://platform.claude.com/settings/keys).
# Without it the API returns the best-matching document excerpt instead of a generated answer.
ANTHROPIC_API_KEY=

# Optional: multilingual vector search (https://dashboard.voyageai.com).
# Without it retrieval uses keyword (BM25) search. Needed at ingest time AND at query time.
VOYAGE_API_KEY=

# Optional overrides
# RAG_CLAUDE_MODEL=claude-opus-5-5
# RAG_CLAUDE_EFFORT=low
# RAG_EMBEDDING_MODEL=voyage-3.5
# RAG_TOP_K=4
# RAG_MIN_SIMILARITY=0.3
# ALLOWED_ORIGINS=https://my-frontend.example.com
