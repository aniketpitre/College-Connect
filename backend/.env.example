# Required for answer generation (https://platform.claude.com/settings/keys).
# Without it the API returns the best-matching document excerpt instead of a generated answer.
ANTHROPIC_API_KEY=

# Optional: multilingual vector search (https://dashboard.voyageai.com).
# Without it retrieval uses keyword (BM25) search. Needed at ingest time AND at query time.
VOYAGE_API_KEY=

# MongoDB. Local dev: run scripts/dev_mongo.sh and use
#   MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# Atlas: the mongodb+srv:// connection string. Never commit real credentials.
MONGODB_URI=
# Database name. Production uses "collegeconnect"; Vercel previews use "collegeconnect_preview";
# use "collegeconnect_dev" locally (the seed script refuses the production name).
MONGODB_DB=collegeconnect_dev

# Required for help desk analytics at /app/admin until Phase 1 staff logins: any long random string.
ADMIN_TOKEN=

# --- Sign-in (Phase 1) ---
# Encrypts stored 2-step verification secrets. Long random string; never change it once set.
APP_SECRET_KEY=
# One-time token for creating the first System Admin at /setup. Remove it after setup.
SETUP_TOKEN=
# Session cookies are Secure (HTTPS only). Browsers treat http://localhost as secure, so keep this on.
# COOKIE_SECURE=true
# Public URL used in emailed links (password reset). Defaults to the request's host.
# APP_BASE_URL=https://college-connect.vercel.app

# --- Email (Resend) --- Without a key, emails are only written to the server log.
EMAIL_API_KEY=
# EMAIL_FROM=CollegeConnect <no-reply@your-college-domain>

# Later in Phase 1: CRON_SECRET, BLOB_READ_WRITE_TOKEN.

# Sign-ins allowed per IP address in 15 minutes (a campus network shares one address).
# LOGIN_LIMIT_PER_IP=300
# Let pages on http://localhost:* call the API with cookies (default on locally, off on Vercel).
# ALLOW_LOCALHOST_ORIGINS=true

# Optional overrides
# RAG_CLAUDE_MODEL=claude-opus-5-5
# RAG_CLAUDE_EFFORT=low
# RAG_EMBEDDING_MODEL=voyage-3.5
# RAG_TOP_K=4
# RAG_MIN_SIMILARITY=0.3
# ALLOWED_ORIGINS=https://my-frontend.example.com
